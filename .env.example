# Copy to private, untracked .env and replace the placeholders before deployment.
HOUSE_BILLS_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_50_CHARACTERS_LONG
HOUSE_BILLS_ALLOWED_HOSTS=bills.example.internal
HOUSE_BILLS_CSRF_TRUSTED_ORIGINS=https://bills.example.internal
HOUSE_BILLS_TIME_ZONE=Europe/Stockholm
HOUSE_BILLS_MIGRATE_ON_START=true
# Maximum original PDF bytes (20 MiB); request envelope gets an extra 64 KiB.
HOUSE_BILLS_MAX_PDF_UPLOAD_BYTES=20971520
# Set true only behind a private HTTPS proxy that replaces X-Forwarded-Proto.
HOUSE_BILLS_TRUST_PROXY=false
APP_UID=1000
APP_GID=1000
APP_DATA_PATH=/path/to/private/host-local/house-bills-data
PROXY_NETWORK=replace-with-private-proxy-network
# Use house-bills:local after a local build, or a tested release tag/digest.
HOUSE_BILLS_IMAGE=house-bills:local
