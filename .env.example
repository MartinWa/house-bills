# Copy to private, untracked .env and replace the placeholders before deployment.
HOUSE_BILLS_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_50_CHARACTERS_LONG
# Docker/Podman secrets: leave the value above empty and point this at the file instead.
# HOUSE_BILLS_SECRET_KEY_FILE=/run/secrets/house_bills_secret_key
HOUSE_BILLS_ALLOWED_HOSTS=bills.example.internal
HOUSE_BILLS_CSRF_TRUSTED_ORIGINS=https://bills.example.internal
HOUSE_BILLS_TIME_ZONE=Europe/Stockholm
# Check public GitHub release metadata for the footer's update indicator.
HOUSE_BILLS_UPDATE_CHECK=true
HOUSE_BILLS_MIGRATE_ON_START=true
# Maximum original PDF bytes (20 MiB); request envelope gets an extra 64 KiB.
HOUSE_BILLS_MAX_PDF_UPLOAD_BYTES=20971520
# Set true only behind a private HTTPS proxy that replaces X-Forwarded-Proto.
HOUSE_BILLS_TRUST_PROXY=false
APP_UID=1000
APP_GID=1000
APP_DATA_PATH=/path/to/private/host-local/house-bills-data
# Name of the private network the container joins; compose.proxy-network.yaml
# replaces it with PROXY_NETWORK instead.
HOUSE_BILLS_NETWORK=house-bills
PROXY_NETWORK=replace-with-private-proxy-network
# Loopback port used only together with compose.host-port.yaml.
HOUSE_BILLS_HOST_PORT=8000
# Use house-bills:local after a local build, or a tested release tag/digest.
HOUSE_BILLS_IMAGE=house-bills:local
# Read-only parser directory inside the container. Leave empty to parse nothing; set
# it with compose.parser-plugins.yaml. Without an installed parser every upload is a
# manual review proposal.
# HOUSE_BILLS_PARSER_PLUGINS=/parsers
# Optional path file for the same setting, e.g. a Docker/Podman secret.
# HOUSE_BILLS_PARSER_PLUGINS_FILE=/run/secrets/house_bills_parser_path
# Operator-owned host directory containing single-file parsers, for example a copy of
# docs/examples/parsers. It must already exist, sit outside APP_DATA_PATH and be
# readable by APP_UID.
APP_PARSER_PATH=/path/to/operator-owned/parser-code
